# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: all of them, real values live only in .env.local (see README for the names)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local job folders and renders
/.local/

# private working notes: kept on this computer, never published
/CLAUDE.md
/PROGRESS.md
/.claude/
/SETUP.md
/docs/
/AGENTS.md
